{
  "expo": {
    "name": "Culla",
    "slug": "culla",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1B16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.reallifeofmine.culla"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "culla",
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Culla looks at your photos on this phone to find similar shots and ones you may not want. Nothing is uploaded.",
          "savePhotosPermission": "Culla saves edited and compressed copies of your photos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}